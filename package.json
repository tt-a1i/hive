{
  "name": "@tt-a1i/hive",
  "version": "2.2.1",
  "description": "Run Claude Code, Codex, Gemini, OpenCode, Qwen, Pi, and other CLI agents as a visible local team in your browser.",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "license": "BUSL-1.1",
  "keywords": [
    "ai-agents",
    "cli",
    "coding-agent",
    "collaboration",
    "local-first",
    "multi-agent",
    "pty",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tt-a1i/hive.git"
  },
  "bugs": {
    "url": "https://github.com/tt-a1i/hive/issues"
  },
  "homepage": "https://github.com/tt-a1i/hive#readme",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "files": [
    "assets/",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE.BSL",
    "NOTICE",
    "README.md",
    "README.en.md",
    "README.zh.md",
    "SECURITY.md",
    "TRADEMARK.md",
    "dist/bin/",
    "dist/src/",
    "dist/vendor/",
    "web/dist/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "hive": "dist/src/cli/hive.js"
  },
  "scripts": {
    "clean": "node scripts/clean-build.mjs",
    "dev": "pnpm dev:all",
    "dev:all": "concurrently \"pnpm dev:runtime\" \"pnpm dev:web\"",
    "dev:runtime": "tsx src/cli/hive.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/prepare-build-artifacts.mjs && pnpm build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "pnpm exec biome check .",
    "compat:cli:report": "node scripts/cli-compat-report.mjs",
    "format": "pnpm exec biome format --write .",
    "pack:check": "npm pack --dry-run --json",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "release:dry": "pnpm check && pnpm build && pnpm pack:check && pnpm pack:smoke",
    "release:full": "pnpm check && pnpm build && pnpm test && pnpm pack:check && pnpm pack:smoke",
    "stress:multidevice": "tsx scripts/remote-stress-multidevice.ts",
    "stress:throughput": "tsx --expose-gc scripts/remote-stress-throughput.ts",
    "sync:marketplace": "node scripts/sync-marketplace.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:mobile-e2e": "node scripts/validate-mobile-runtime-e2e.mjs",
    "test:switch-layout": "node scripts/validate-settings-switch-layout.mjs",
    "test:windows": "node scripts/run-windows-tests.mjs",
    "test:watch": "vitest",
    "prototype:desktop": "vite --config web/vite.config.ts --open '/prototype-hive-desktop.html?variant=A'"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.15",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.0",
    "cron-parser": "^5.5.0",
    "esbuild": "^0.28.0",
    "gray-matter": "^4.0.3",
    "isomorphic-dompurify": "^3.14.0",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.4",
    "qrcode": "1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.12",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.6.0",
    "@types/qrcode": "1.5.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.9.0",
    "concurrently": "^9.1.2",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ],
    "patchedDependencies": {
      "@xterm/xterm@6.0.0": "patches/@xterm__xterm@6.0.0.patch"
    }
  }
}
